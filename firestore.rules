rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcı SADECE kendi belgesini (users/{kendi_uid'si}) okuyup yazabilir.
    // Başka bir kullanıcının verisine asla erişemez.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
